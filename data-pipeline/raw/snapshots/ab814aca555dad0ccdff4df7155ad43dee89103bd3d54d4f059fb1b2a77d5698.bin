    </div>

    <script>
    </script>










    <script type="text/javascript">



        /*
            Enterkey 이벤트 막기
         */
        // ---------------------------------------------------------------------------------
        document.addEventListener("keypress", function (e) {
        	if(e.keyCode == 13) e.preventDefault();
        });
        // ---------------------------------------------------------------------------------


        /*
            Selector 선언
         */
        // ---------------------------------------------------------------------------------
        let form;

        let searchButton;
        let resetButton;
        let detailSearchButton;

        let searchConditaionSelector;

        let typeCodeCombotree;										// 분류정보 - 셀렉트박스 - 유형별 분류(2중)
        let operatorSelectorToTitle;
        let operatorSelectorToProduce;
        let operatorSelectorToPublish;
        let operatorSelectorToCollect;

        let timelineAndHistoricalSiteSelector;

        let mapAnchorSelector;
        // ---------------------------------------------------------------------------------


        /*
