         */
        // ---------------------------------------------------------------------------------
        const options = {
            // timenav_height : 225,
            slide_padding_lr : 100,
            duration : 1000,
            scale_factor : 20,
            zoom_sequence : [10, 15, 20, 25]
            /*start_at_slide : 20*/
            /*hash_bookmark: true*/
        };
        // ---------------------------------------------------------------------------------



        /*
            timeline 호출
         */
        // ---------------------------------------------------------------------------------
        const timeline = new TL.Timeline('timeline', {"events":[{"unique_id":"marker136","media":{"thumbnail":"/record/file/6038/thumbnail/image/download.do","url":"/record/file/6038/thumbnail/image/download.do"},"text":{"text":"","headline":"<a href=\"javascript:;\" class=\"__timeline__anchor\" onclick=\"handleMoveToRecordDetail(6038)\">미군 상륙에 즈음한 미군사령관의 포고1(U.S. Military Commander's Declaration at the Landing)<\/a>","subheadline":""},"start_date":{"month":"9","display_date":"1945년 9월 ","year":"1945","day":"9"}},{"unique_id":"marker181","media":{"thumbnail":"/record/file/5824/thumbnail/image/download.do","url":"/record/file/5824/thumbnail/image/download.do"},"text":{"text":"","headline":"<a href=\"javascript:;\" class=\"__timeline__anchor\" onclick=\"handleMoveToRecordDetail(5824)\">메이데이(May Day in Cheju-Do)<\/a>","subheadline":"메이데이"},"start_date":{"month":"5","display_date":"1948년 5월 ","year":"1948","day":"1"}},{"unique_id":"marker328","media":{"thumbnail":"/record/file/6016/thumbnail/image/download.do","url":"/record/file/6016/thumbnail/image/download.do"},"text":{"text":"","headline":"<a href=\"javascript:;\" class=\"__timeline__anchor\" onclick=\"handleMoveToRecordDetail(6016)\">제주비행장에 도착한 미군정 수뇌부<\/a>","subheadline":""},"start_date":{"month":"5","display_date":"1948년 5월 ","year":"1948","day":"5"}},{"unique_id":"marker295","media":{"thumbnail":"/record/file/6013/thumbnail/image/download.do","url":"/record/file/6013/thumbnail/image/download.do"},"text":{"text":"","headline":"<a href=\"javascript:;\" class=\"__timeline__anchor\" onclick=\"handleMoveToRecordDetail(6013)\">41주기 4·3추모제 포스터<\/a>","subheadline":""},"start_date":{"month":"4","display_date":"1989년 4월 ","year":"1989","day":"1"}},{"unique_id":"marker292","media":{"thumbnail":"/record/file/5877/thumbnail/image/download.do","url":"/record/file/5877/thumbnail/image/download.do"},"text":{"text":"","headline":"<a href=\"javascript:;\" class=\"__timeline__anchor\" onclick=\"handleMoveToRecordDetail(5877)\">4·3의 증언 제주신문 취재수첩(88~89)<\/a>","subheadline":""},"start_date":{"month":"6","display_date":"1990년 6월 ","year":"1990","day":"2"}},{"unique_id":"marker300","media":{"thumbnail":"/record/file/5823/thumbnail/image/download.do","url":"/record/file/5823/thumbnail/image/download.do"},"text":{"text":"","headline":"<a href=\"javascript:;\" class=\"__timeline__anchor\" onclick=\"handleMoveToRecordDetail(5823)\">제주4·3 제50주년 기념식 및 명예회복 촉구대회 포스터<\/a>","subheadline":""},"start_date":{"month":"4","display_date":"1998년 4월 ","year":"1998","day":"4"}},{"unique_id":"marker305","media":{"thumbnail":"/record/file/5885/thumbnail/image/download.do","url":"/record/file/5885/thumbnail/image/download.do"},"text":{"text":"","headline":"<a href=\"javascript:;\" class=\"__timeline__anchor\" onclick=\"handleMoveToRecordDetail(5885)\">제주4·3사건진상규명 및 희생자명예회복 위원회' (위원장 국무총리) 발족<\/a>","subheadline":""},"start_date":{"month":"8","display_date":"2000년 8월 ","year":"2000","day":"28"}},{"unique_id":"marker309","media":{"thumbnail":"/record/file/1/thumbnail/image/download.do","url":"/record/file/1/thumbnail/image/download.do"},"text":{"text":"","headline":"<a href=\"javascript:;\" class=\"__timeline__anchor\" onclick=\"handleMoveToRecordDetail(1)\">제주4·3사건자료집4 (정부문서·국회속기록·잡지편)<\/a>","subheadline":""},"start_date":{"month":"1","display_date":"2003년 1월 ","year":"2003","day":"1"}},{"unique_id":"marker311","media":{"thumbnail":"/record/file/5813/thumbnail/image/download.do","url":"/record/file/5813/thumbnail/image/download.do"},"text":{"text":"","headline":"<a href=\"javascript:;\" class=\"__timeline__anchor\" onclick=\"handleMoveToRecordDetail(5813)\">제주4·3사건진상조사보고서<\/a>","subheadline":""},"start_date":{"month":"10","display_date":"2003년 10월 ","year":"2003","day":"15"}},{"unique_id":"marker316","media":{"thumbnail":"/record/file/5884/thumbnail/image/download.do","url":"/record/file/5884/thumbnail/image/download.do"},"text":{"text":" ","headline":"<a href=\"javascript:;\" class=\"__timeline__anchor\" onclick=\"handleMoveToRecordDetail(5884)\">제주4·3평화재단 현판식(2008년11월10일)<\/a>","subheadline":" "},"start_date":{"month":"11","display_date":"2008년 11월 ","year":"2008","day":"10"}},{"unique_id":"marker321","media":{"thumbnail":"/record/file/5814/thumbnail/image/download.do","url":"/record/file/5814/thumbnail/image/download.do"},"text":{"text":"","headline":"<a href=\"javascript:;\" class=\"__timeline__anchor\" onclick=\"handleMoveToRecordDetail(5814)\">제주4·3사건추가진상조사보고서 I<\/a>","subheadline":""},"start_date":{"month":"12","display_date":"2019년 12월 ","year":"2019","day":"30"}},{"unique_id":"marker268","media":{"thumbnail":"/record/file/9173/thumbnail/image/download.do","url":"/record/file/9173/thumbnail/image/download.do"},"text":{"text":"","headline":"<a href=\"javascript:;\" class=\"__timeline__anchor\" onclick=\"handleMoveToRecordDetail(9173)\">4·3과 평화-63호<\/a>","subheadline":""},"start_date":{"month":"2","display_date":"2021년 2월 ","year":"2021","day":"26"}}]}, options);
        $('.tl-slide-content').css('padding', '0 0');
        // ---------------------------------------------------------------------------------



        /*
            Onload 이벤트
         */
        // ---------------------------------------------------------------------------------
        $(function() {
            openNoticePopup();

            // 팝업닫기
            $(".pop_notice .__pop__notice__close").on('click', function(e) {

                if(getCookie("notice_popup") != "Y" && document.querySelector("#today_check").checked){
                    var todayDate = new Date();
                    todayDate.setDate( todayDate.getDate() + 1 );
                    document.cookie = "pop_notice" + '=' + escape( 'Y' ) + '; path=/; expires=' + todayDate.toGMTString() + ';'
                }

                $(".pop_notice").hide();
            });

            // datepicker 설정
            $('.datepickerCustom').datepicker({
                yearRange: "c-100:c",
                changeMonth: false,
                changeYear: true,
                showButtonPanel: true,
                closeText:'Select',
                currentText: 'This year',
                onClose: function(dateText, inst) {
                    var year = $("#ui-datepicker-div .ui-datepicker-year :selected").val();
                    $(this).val($.datepicker.formatDate('yy', new Date(year, 1, 1)));
                }
            }).focus(function () {
                $(".ui-datepicker-month").hide();
                $(".ui-datepicker-calendar").hide();
                // $(".ui-datepicker-current").hide();
                $(".ui-datepicker-prev").hide();
                $(".ui-datepicker-next").hide();
                $("#ui-datepicker-div").position({
                    my: "left top",
                    at: "left bottom",
                    of: $(this)
                });
            }).attr("readonly", false);

            // 타임라인 설정
            let window_width = window.outerWidth;
            if(window_width < 768){
                $('.tl-slide-content-container').css('padding', '0 0 0 0');
                $('.tl-timenav').css('background-color', 'rgb(124 124 124)');
            }else{
                $('.tl-slide-content-container').css('padding', '0 100px 0 100px');
                $('.tl-timenav').css('background-color', 'rgb(124 124 124)');
            }

            $(window).resize(function(){
                var nav_height = $('.tl-timenav-slider-background').height();
                var axis_height = $('.tl-timeaxis').height();
                $('.tl-timenav-line').height(nav_height - axis_height);
            });

            // $("ul.tab5 li").click(function(){
            //     $("ul.tab5 li, .tab_box").removeClass('on');
            //     $(this).addClass('on');
            //     $("#"+$(this).data('id')).addClass('on');
            // });
            // $("ul.tab5 li:first-child").click();


            // 유형별분류 코드 - 분류정보
            $.post('/classification/getClassListForCombobox.do;jsessionid=BD9DBB7EEB96D22138372BC424AC8969', {id: 'CL-FRM'}, function(data) {
                // 전체 또는 선택값 넣는 방법
                const addDatas = {parent_code_cd: 'CL-FRM', level: 1, id: '', title: '1수준 - 선택'};
                data.codeList.unshift(addDatas);
                typeCodeCombotree = data.codeList.map(function (item) {
                    return item;
                });

                document.querySelector(".__type__one__depth ul").innerHTML = "";
                typeCodeCombotree.forEach(function (item) {
                    const createLi = document.createElement("li");
                    const createAnchor = document.createElement("a");
                    createAnchor.href = "javascript:void(0);";
                    createAnchor.dataset.code = item.id;
                    createAnchor.dataset.name = item.title;
                    createAnchor.textContent = item.title;
                    createAnchor.addEventListener("click", handleSelectToTypeOneDepth);
                    createLi.appendChild(createAnchor);
                    document.querySelector(".__type__one__depth ul").appendChild(createLi);
                });
            });


            // 이벤트 설정
            handleAddEvent();
        });
        // ---------------------------------------------------------------------------------



        /*
            쿠키 설정
         */
        // ---------------------------------------------------------------------------------
        function getCookie(name) {
            var obj = name + "=";
            var x = 0;
            while (x <= document.cookie.length) {
                var y = (x+obj.length);
                if ( document.cookie.substring( x, y ) == obj ) {
                    if ((endOfCookie=document.cookie.indexOf( ";", y )) == -1 )
                        endOfCookie = document.cookie.length;
                    return unescape( document.cookie.substring( y, endOfCookie ) );
                }
                x = document.cookie.indexOf( " ", x ) + 1;

                if ( x == 0 ) break;
            }
            return "";
        }
        // ---------------------------------------------------------------------------------



        /*
            메인 공지팝업 열기
         */
        // ---------------------------------------------------------------------------------
        function openNoticePopup() {
            if(getCookie("pop_notice") != "Y" && $(".pop_notice").length > 0 ) {

                // 팝업
                $('.popup_container .slider').slick({
	                slidesToShow: 1,
	                slidesToScroll: 1,
	                infinite: false,
	                arrows: true,
	                dots: false,
	                variableWidth: true
                });

                $(".pop_notice").show();
            } else {
                $(".pop_notice").hide();
            }
        }
        // ---------------------------------------------------------------------------------



        /*
            Selector 초기화 및 이벤트 설정
         */

        // ---------------------------------------------------------------------------------
        function handleAddEvent() {
            form = document.searchForm;

            searchButton = document.querySelector(".searchButton");
            searchButton.addEventListener("click", handleSearch);

            detailSearchButton = document.querySelector(".detailSearchButton");
            detailSearchButton.addEventListener("click", handleSearchToDetail);

            resetButton = document.querySelector(".resetButton");
            resetButton.addEventListener("click", handleResetToDetailContent);


            searchConditaionSelector = document.querySelectorAll(".searchCondition li a");
            Array.prototype.slice.call(searchConditaionSelector).forEach(function (item) {
                item.addEventListener("click", handleChangeToSearchCondition);
            });

            operatorSelectorToTitle = document.querySelectorAll(".__title li a");
            Array.prototype.slice.call(operatorSelectorToTitle).forEach(function (item) {
                item.addEventListener("click", handleSelectToOperator);
            })

            operatorSelectorToProduce = document.querySelectorAll(".__producer__name li a");
            Array.prototype.slice.call(operatorSelectorToProduce).forEach(function (item) {
                item.addEventListener("click", handleSelectToOperator);
            });

            operatorSelectorToPublish = document.querySelectorAll(".__form__publication__issue li a");
            Array.prototype.slice.call(operatorSelectorToPublish).forEach(function (item) {
                item.addEventListener("click", handleSelectToOperator);
            });

            operatorSelectorToCollect = document.querySelectorAll(".__collector__name li a");
            Array.prototype.slice.call(operatorSelectorToCollect).forEach(function (item) {
                item.addEventListener("click", handleSelectToOperator);
            });

            timelineAndHistoricalSiteSelector = document.querySelectorAll(".__timeline__history__tab li a");
            Array.prototype.slice.call(timelineAndHistoricalSiteSelector).forEach(function (item) {
                item.addEventListener("click", handleSwitchToMainTab);
            });

            mapAnchorSelector = document.querySelectorAll(".__historical__site .map_container a");
            Array.prototype.slice.call(mapAnchorSelector).forEach(function (item) {
                item.addEventListener("click", handleGoToHistoricalSite);
            })

        }
        // ---------------------------------------------------------------------------------



        /*
            4·3유적지 지도 클릭 이벤트
         */
        // ---------------------------------------------------------------------------------
        function handleGoToHistoricalSite() {
            const target = this;
            const targetCode = target.dataset.target;
            document.querySelector("input[name=siteCode]").value = targetCode;

            form.action = "/events/history/history.do";
            form.submit();
        }
        // ---------------------------------------------------------------------------------



        /*
            메인화면 시대별기록 / 유적지 탭 스위칭 -> 다 제거했다가 선택한 것만 넣어주는 방법으로..
         */
        // ---------------------------------------------------------------------------------
        function handleSwitchToMainTab() {
            const target = this;
            const targetDiv = target.dataset.target;
            Array.prototype.slice.call(timelineAndHistoricalSiteSelector).forEach(function (item) {
                item.parentNode.classList.remove("on");
                document.querySelector("." + item.dataset.target).style.display = "none";
            });
            target.parentNode.classList.add("on");
            document.querySelector("." + targetDiv).style.display = "block";
        }
        // ---------------------------------------------------------------------------------
        


        /*
            AND / OR / NOT 연산자 처리 이벤트
         */
        // ---------------------------------------------------------------------------------
        function handleSelectToOperator() {
            const target = this;
            console.log(target.parentNode.parentNode.parentNode.classList.value);
            target.parentNode.parentNode.parentNode.querySelector("p").textContent = target.textContent;
            target.parentNode.parentNode.parentNode.parentNode.querySelector("input[type=hidden]").value = target.textContent;
        }
        // ---------------------------------------------------------------------------------



        /*
            유형분류 - One depth 이벤트
         */
        // ---------------------------------------------------------------------------------
        function handleSelectToTypeOneDepth() {
            const target = this;
            const selectedCode = target.dataset.code;
            document.querySelector(".__type__one__depth p").textContent = target.dataset.name;
            document.querySelector("input[name=_parentCategoryTypeCl]").value = target.dataset.code;

            // document.querySelector(".__type__one__depth").classList.remove("on");
            // document.querySelector(".__type__one__depth ul").style.display = "none";
            $(".__type__one__depth").removeClass("on");
            $(".__type__one__depth > ul").slideUp(500);

            handleDrawToTypeTwoDepth(selectedCode);
        }
        // ---------------------------------------------------------------------------------



        /*
            유형분류 - Two depth 이벤트
         */
        // ---------------------------------------------------------------------------------
        function handleSelectToTypeTwoDepth() {
            const target = this;
            document.querySelector(".__type__two__depth p").textContent = target.dataset.name;
            document.querySelector("input[name=_filterTypeClassificationCl]").value = target.dataset.code;

            // document.querySelector(".__type__two__depth").classList.remove("on");
            // document.querySelector(".__type__two__depth ul").style.display = "none";
            $(".__type__two__depth").removeClass("on");
            $(".__type__two__depth > ul").slideUp(500);
        }
        // ---------------------------------------------------------------------------------



        /*
            유형분류 - Two depth 그리기
         */
        // ---------------------------------------------------------------------------------
        function handleDrawToTypeTwoDepth(selectedCode) {
            let targetDataset = typeCodeCombotree;

            // 선택한 항목 추출
            const oneDepthArray = targetDataset.filter(function (item) {
                if(selectedCode == item.id || (selectedCode.indexOf(item.id) > -1 && item.id !== '')) {
                    return item;
                }
            });

            // 두번째 콤보박스 li 태그 제거
            document.querySelector(".__type__two__depth ul").innerHTML = '';

            if(!oneDepthArray[0].subs) {
                const createLi = document.createElement("li");
                const createAnchor = document.createElement("a");
                createAnchor.href = "javascript:void(0);";
                createAnchor.dataset.code = "";
                createAnchor.dataset.name = "2수준 - 선택";
                createAnchor.textContent = "2수준 - 선택";
                createAnchor.addEventListener("click", handleSelectToTypeTwoDepth);
                createLi.appendChild(createAnchor);

                document.querySelector(".__type__two__depth ul").appendChild(createLi);
            } else {
                let tempArray = oneDepthArray[0].subs.slice(oneDepthArray[0].subs);

                // 선택항목 추가
                if(tempArray[0].title !== '2수준 - 선택') {
                    const addDatas = {parent_class_cd: tempArray[0].parent_class_cd, level: 2, id: '', title: '2수준 - 선택'};
                    tempArray.unshift(addDatas);
                }

                tempArray.forEach(function (item) {
                    const createLi = document.createElement("li");
                    const createAnchor = document.createElement("a");
                    createAnchor.href = "javascript:void(0);";
                    createAnchor.dataset.code = item.id;
                    createAnchor.dataset.name = item.title;
                    createAnchor.textContent = item.title;
                    createAnchor.addEventListener("click", handleSelectToTypeTwoDepth);
                    createLi.appendChild(createAnchor);

                    document.querySelector(".__type__two__depth ul").appendChild(createLi);
                });
            }
            document.querySelectorAll(".__type__two__depth ul li a").item(0).click();
        }
        // ---------------------------------------------------------------------------------



        /*
            검색조건 변경 이벤트
         */
        // ---------------------------------------------------------------------------------
        function handleChangeToSearchCondition() {
            const target = this;
            document.querySelector("input[name=searchCondition]").value = target.dataset.condition;
            document.querySelector(".searchCondition p").textContent = target.dataset.name;
        }
        // ---------------------------------------------------------------------------------



        /*
            검색
         */
        // ---------------------------------------------------------------------------------
        function handleSearch() {
            const searchKeyword = document.querySelector("input[name=searchKeyword]").value;
            if(searchKeyword == '') {
                alert("키워드를 입력해주세요.");
                return;
            }

            if(document.querySelector("input[name=_rangeProduceYearStart]").value == "") {
                document.querySelector("input[name=rangeProduceYearStart]").value = -1;
            } else {
                document.querySelector("input[name=rangeProduceYearStart]").value = -document.querySelector("input[name=_rangeProduceYearStart]").value;
            }
            if(document.querySelector("input[name=_rangeProduceYearEnd]").value == "") {
                document.querySelector("input[name=rangeProduceYearEnd]").value = -1;
            } else {
                document.querySelector("input[name=rangeProduceYearEnd]").value = -document.querySelector("input[name=_rangeProduceYearEnd]").value;
            }

            document.querySelector("input[name=searchType]").value = "01";
            form.action = "/search/archive/keywordSearch.do";
            form.submit();
        }
        // ---------------------------------------------------------------------------------



        /*
            상세 검색
         */
        // ---------------------------------------------------------------------------------
        function handleSearchToDetail() {

            document.querySelector("input[name=searchKeyword]").value = "";

            if(document.querySelector("input[name=_title]").value != "") {
                document.querySelector("input[name=title]").value = document.querySelector("input[name=_title]").value;
            }

            if(document.querySelector("input[name=_producerName]").value != "") {
                document.querySelector("input[name=producerName]").value = document.querySelector("input[name=_producerName]").value;
            }

            if(document.querySelector("input[name=_collectorName]").value != "") {
                document.querySelector("input[name=collectorName]").value = document.querySelector("input[name=_collectorName]").value;
            }

            if(document.querySelector("input[name=_parentCategoryTypeCl]").value != "") {
                document.querySelector("input[name=parentCategoryTypeCl]").value = document.querySelector("input[name=_parentCategoryTypeCl]").value;
            }

            if(document.querySelector("input[name=_filterTypeClassificationCl]").value != "") {
                document.querySelector("input[name=filterTypeClassificationCl]").value = document.querySelector("input[name=_filterTypeClassificationCl]").value;
            }

            if(document.querySelector("input[name=_rangeProduceYearStart]").value == "") {
                document.querySelector("input[name=rangeProduceYearStart]").value = -1;
            } else {
                document.querySelector("input[name=rangeProduceYearStart]").value = -document.querySelector("input[name=_rangeProduceYearStart]").value;
            }
            if(document.querySelector("input[name=_rangeProduceYearEnd]").value == "") {
                document.querySelector("input[name=rangeProduceYearEnd]").value = -1;
            } else {
                document.querySelector("input[name=rangeProduceYearEnd]").value = -document.querySelector("input[name=_rangeProduceYearEnd]").value;
            }

            if(document.querySelector("input[name=_operator1]").value != "") {
                document.querySelector("input[name=operator1]").value = document.querySelector("input[name=_operator1]").value;
            }

            if(document.querySelector("input[name=_operator2]").value != "") {
                document.querySelector("input[name=operator2]").value = document.querySelector("input[name=_operator2]").value;
            }

            document.querySelector("input[name=searchType]").value = "02";
            form.action = "/search/archive/detailSearch.do";
            form.submit();
        }
        // ---------------------------------------------------------------------------------



        /*
            상세 조건 초기화
         */
        // ---------------------------------------------------------------------------------
        function handleResetToDetailContent() {
            document.querySelector("input[name=_title]").value = "";
            document.querySelector("input[name=_producerName]").value = "";
            document.querySelector("input[name=_collectorName]").value = "";
            document.querySelector("input[name=_filterTypeClassificationCl]").value = document.querySelectorAll(".__type__one__depth ul li a").item(0).click();
            document.querySelector("input[name=_rangeProduceYearStart]").value = "";
            document.querySelector("input[name=_rangeProduceYearEnd]").value = "";
            document.querySelector("input[name=_operator1]").value = operatorSelectorToTitle.item(0).click();
            document.querySelector("input[name=_operator2]").value = operatorSelectorToProduce.item(0).click();
            // typeCodeCombotree
        }
        // ---------------------------------------------------------------------------------



        /*
            타임라인 타이틀 클릭 이벤트
         */
        // ---------------------------------------------------------------------------------
        function handleMoveToRecordDetail(recordNo) {
            const newWindow = window.open("about:blank");
            newWindow.location.href = "/data/getRecord.do?record_no=" + recordNo;
        }
        // ---------------------------------------------------------------------------------


    </script>


	

