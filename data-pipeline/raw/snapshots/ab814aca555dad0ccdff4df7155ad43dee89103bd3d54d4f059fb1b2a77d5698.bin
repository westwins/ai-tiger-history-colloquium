    <div class="popup pop_notice" style="display: none;">
        <div class="dim"></div>
        <div class="popup_container">
            <div class="slider">
                <div>
                    <a href="/archive/useGuide.do" title="자료 이용 안내 페이지로 이동"><img src="/resource/portal/images/popup_usage_guide.png" alt=""/></a>
                </div>
            </div>
            <div class="overflow-h">
                <div class="float-left">
                    <p class="today_check"><input type="checkbox" id="today_check"><label for="today_check">오늘 하루 열지 않기</label></p>
                </div>
