                        <div class="input_label">생산년도</div>
                        <div class="input_group">
                            
                            <input type="text" class="datepickerCustom w50p" name="_rangeProduceYearStart" title="생산년도 시작일" autocomplete="off" value="" />
                            <input type="text" class="datepickerCustom w50p" name="_rangeProduceYearEnd" title="생산년도 종료일" autocomplete="off" value="" />
                        </div>
