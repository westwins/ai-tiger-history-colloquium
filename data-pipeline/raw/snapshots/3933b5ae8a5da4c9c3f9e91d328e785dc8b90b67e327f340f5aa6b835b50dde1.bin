    <script>

        let tempArray;


        /*
            Onload 이벤트
         */
        // ---------------------------------------------------------------------------------
        $(document).ready(function() {
            // const dataArray = [
            //     { name: 'Chrome', y: 61.41, cnt: 1500, color: '#5749ad'},
            //     { name: 'Internet Explorer', y: 11.84, cnt: 600 },
            //     { name: 'Firefox', y: 10.85, cnt: 500 },
            //     { name: 'Edge', y: 4.67, cnt: 250 },
            //     { name: 'Safari', y: 4.18, cnt: 240 },
            //     { name: 'Other', y: 7.05, cnt: 340 }
            // ];

            handleSearchToStaticsData();

        })
        // ---------------------------------------------------------------------------------



        /*
            통계 데이터 조회
         */
        // ---------------------------------------------------------------------------------
        function handleSearchToStaticsData() {
            const searchUrl = "/archive/getDataStatistics.do";

            let searchDatas = {};

            $.ajax({
                type: 'POST',
                url: searchUrl,
                dataType: 'json',
                data: JSON.stringify(searchDatas),
                async: false,
                contentType: "application/json",
                traditional: true,
                success: function(data) {
                    // console.log(data.columnStaticsList);

                    if(data.pieStaticsList.length > 0) {
                        handleDrawToPie(data.pieStaticsList);
                    }

                    if(data.columnStaticsList.length > 0) {
                        handleDrawToColumn(data.columnStaticsList);
                    }

                }, error: function(err) {
                    console.log(err);
                }
            });
        }
        // ---------------------------------------------------------------------------------









        /*
            파이 그래프 그리기
            http://www.w3big.com/try/try.php?filename=highcharts_pie_gradient
         */
        // ---------------------------------------------------------------------------------
        function handleDrawToPie(dataArray) {
            const chart = {
                plotBackgroundColor: null,
                plotBorderWidth: null,
                plotShadow: false
            };
            const title = {
                text: ''
            };
            const tooltip = {
                pointFormat: '{series.data.name}: <b>{point.y:.1f}% / {point.type_cnt} 건</b>'
            };
            const plotOptions = {
                pie: {
                	size: 355,
                    allowPointSelect: true,
                    cursor: 'pointer',
                    dataLabels: {
                        enabled: true,
                        format: '<b>{point.name}%</b>: {point.y:.1f} %',
                        style: {
                            color: (Highcharts.theme && Highcharts.theme.contrastTextColor) || 'black'
                        }
                    }
                }
            };
            let series= [{
                type: 'pie',
                name: '',
                data: dataArray
            }];
            colors: Highcharts.getOptions().colors.map(function(color) {
                return {
                  linearGradient: {
                    cx: 0.5,
                    cy: 0.5,
                    r: 0.7
                  },
                }
              })

            // highchart 색상 데이터 생성.
            const pieColorList = ['#0EB3B6', '#5AACE5', '#154071', '#007FD0', '#BAEDFE', '#2066AA'];
            const json = {};
            json.chart = chart;
            json.title = title;
            json.tooltip = tooltip;
            json.series = series;
            json.plotOptions = plotOptions;
            json.colors = pieColorList;
            $('#_pieContainer').highcharts(json);
        }
        // ---------------------------------------------------------------------------------



        /*
            막대 그래프 그리기
         */
        // ---------------------------------------------------------------------------------
        function handleDrawToColumn(dataArray) {
            const chart = {
                type: 'column'
            };
            const title = {
                text: ''
            };
            const xAxis = {
                categories: ['문서/도서류', '사진', '시청각', '재단간행물', '박물', '신문']
            };
            const yAxis ={
                //allowDecimals: false,
                min: 0,
                title: {
                    text: ''
                }
            };
            const tooltip = {
                formatter: function () {
                    return '<b>' + this.x + '</b><br/>' +
                        this.series.name + ': ' + this.y + '<br/>' +
                        'Total: ' + this.point.stackTotal;
                }
            }
            const plotOptions = {
                column: {
                    stacking: 'normal',
                    cursor: 'pointer'
                },
                series: {
                    pointWidth: 30
                }
            };
            const credits = {
                enabled: false
            };
            let series = dataArray;

            // highchart 색상 데이터 생성.
            const columnColorList = ['#2066AA', '#DAA30B', '#E7D8B0', '#499D76', '#5F8A69', '#B23B64', '#333333', '#E68421', '#6363AB', '#82B0DC', '#1E8EDC', '#0EB3B6', '#9F856A', '#E5A5C3', '#8D66A7'];

            const json = {};
            json.chart = chart;
            json.title = title;
            json.xAxis = xAxis;
            json.yAxis = yAxis;
            json.tooltip = tooltip;
            json.plotOptions = plotOptions;
            json.credits = credits;
            json.series = series;
            json.colors = columnColorList;
            $('#_columnContainer').highcharts(json);
        }
        // ---------------------------------------------------------------------------------

    </script>




	

