    <script src="/resource/portal/js/jeju.panzoom.js"></script>
    <script src="/resource/portal/js/jeju.image.zoom.js"></script>
    <script>


        /*
            Selector 선언
         */
        // ---------------------------------------------------------------------------------
        let sourceTypeClCombotree;										// 분류정보 - 셀렉트박스 - 출처별 분류(2중)
        let eventTypeClCombotree;										// 분류정보 - 셀렉트박스 - 사건별(시대별) 분류(2중)
        let placeTypeClCombotree;										// 분류정보 - 셀렉트박스 - 장소별 분류(2중)
        let formTypeClCombotree;										// 분류정보 - 셀렉트박스 - 유형별 분류(2중)
        let contentsButton;
        let goListButton;
        let snsOpenButton;
        let snsCloseButton;
        // ---------------------------------------------------------------------------------



        /*
            Onload 이벤트
         */
        // ---------------------------------------------------------------------------------
        window.onload = function () {

            // Selector 초기화 및 이벤트 설정
            handleInitAndAddEvent();

            // 유형 분류체계 및 출처 분류체계 정보 설정
            handleWriteToClassificationInfo();
        }
        // ---------------------------------------------------------------------------------



        /*
            Selector 초기화 및 이벤트 설정
         */
        // ---------------------------------------------------------------------------------
        function handleInitAndAddEvent() {
            goListButton = document.querySelector(".__go__list");
            goListButton.addEventListener("click", handleMoveToPage);

            contentsButton = document.querySelector(".__contents");
            contentsButton.addEventListener("click", handleShowToTypeItem);

            snsOpenButton = document.querySelector(".btn_sns_open");
            snsOpenButton.addEventListener("click", handleChangeToSnsStatus);
            snsCloseButton = document.querySelector(".btn_sns_close");
            snsCloseButton.addEventListener("click", handleChangeToSnsStatus);
        }
        // ---------------------------------------------------------------------------------



        /*
            유형 분류체계 및 출처 분류체계 정보 설정
            -> 출처 분류체계가 2개 이상 가능하기 때문에 코드로 처리
         */
        // ---------------------------------------------------------------------------------
        function handleWriteToClassificationInfo() {

            // 출처별분류 코드 - 분류정보
            $.post('/classification/getClassListForCombobox.do;jsessionid=7693DEA169C9752FC2E852731F4D70B0', {id: 'CL-SOU'}, function(data) {
                sourceTypeClCombotree = data.codeList.map(function (item) {
                    return item;
                });
                const sourceStr = document.querySelector("input[name=source_classification_cl]").value;
                if(sourceStr != "") {
                    let sourceStrArray = sourceStr.split(",");
                    let sourceArray = [];
                    console.log(sourceStrArray);
                    sourceStrArray.forEach(function (arrayItem) {
                        let sourceObject = {};
                        sourceTypeClCombotree.forEach(function (item) {
                            if(arrayItem === item.id) {
                                sourceObject.upper_class_cd_name = item.title;
                            } else {
                                if(arrayItem.indexOf(item.id) > -1) {
                                    sourceObject.upper_class_cd_name = item.title;
                                    item.subs.forEach(function (subItem) {
                                        if(arrayItem === subItem.id) {
                                            sourceObject.class_cd_name = subItem.title;
                                        }
                                    });
                                }
                            }
                        });
                        sourceArray.push(sourceObject);
                    });

                    const targetUl = document.querySelectorAll("#__archive__type__area ul").item(1);
                    const targetLi = targetUl.querySelector('li');
                    sourceArray.forEach(function (item, index) {
                        if(index == 0) {
                            targetLi.querySelector('span').textContent = item.upper_class_cd_name + (item.class_cd_name === undefined ? '' : '-' + item.class_cd_name);
                        } else {
                            const cloneLi = targetLi.cloneNode(true);
                            cloneLi.querySelector('em').textContent = '';
                            cloneLi.querySelector('span').textContent = item.upper_class_cd_name + (item.class_cd_name === undefined ? '' : '-' + item.class_cd_name);
                            targetUl.appendChild(cloneLi);
                        }
                    });
                } else {
                    document.querySelectorAll("#__archive__type__area ul").item(1).querySelector('li span').textContent = "정보없음";
                }
            });

            // 유형별분류 코드 - 분류정보 -> 유형별 분류 체계는 기록물 당 1개로 변경하여 실제로 아래 코드를 사용하지 않아도 가능함.
            
            
            
            
            
            
            
            
            
            
            
            
            
            
            
            
            
            
            
            
            
            
            
            
            

            
            
            
            
            
            
            
            
            
            
            
            
            
        }
        // ---------------------------------------------------------------------------------



        /*
            SNS 버튼 이벤트
         */
        // ---------------------------------------------------------------------------------
        function handleChangeToSnsStatus() {
            const target = this;
            if(target.classList.value.indexOf("open") > -1) {
                snsOpenButton.classList.add("on");
            } else {
                snsOpenButton.classList.remove("on");
            }
        }
        // ---------------------------------------------------------------------------------



        /*
            내용보기 버튼 이벤트
         */
        // ---------------------------------------------------------------------------------
        function handleShowToTypeItem() {
            const target = this;
            const record_no = target.dataset.recordno;
            const record_type = target.dataset.recordtype;
            const record_streaming_url = target.dataset.streamingurl;
            const file_yn = target.dataset.fileyn;
            const file_extension = target.dataset.fileextension;
            const thumbnail_yn = target.dataset.thumbnailyn;

            // 고객 요청. > 메이데이(May Day in Cheju-Do) 는 유튜브로 노출될 수 있도록..
            if(record_no == 5824) {
                const newWindow = window.open("about:blank");
                newWindow.location.href = "https://www.youtube.com/watch?v=wH7kBkr0Ok4";

            } else if(record_no == 5880) {
                const newWindow = window.open("about:blank");
                newWindow.location.href = "https://www.youtube.com/watch?v=SjXaJpKLL7c";

            } else {
                if(record_streaming_url != null && record_streaming_url != "") {        // 시청각 -> 유튜브 URL
                    const newWindow = window.open("about:blank");
                    newWindow.location.href = record_streaming_url;

                } else if(file_yn == "Y" && file_extension == "pdf") {                  // 문서 -> PDF 다운로드
                    location.href = "/record/file/" + record_no + "/1/download.do";

                } else if(file_yn == "Y" && "JPG,JFIF,JPEG,GIF,BMP,PNG".indexOf(file_extension.toUpperCase()) > -1) {        // 사진 -> html5 뷰어
                    document.querySelector(".__image__box").innerHTML = "";

                    const createImg = document.createElement("img");
                    createImg.src = "/record/file/" + record_no + "/image/download.do";
                    createImg.classList.add("img_zoom");
                    createImg.style.width = "auto";
                    createImg.style.height = "100%";
                    document.querySelector(".__image__box").appendChild(createImg);

                    fnInitZoom();

                    document.querySelector("#pop-image-viewer").style.display = "block";

                } else {
                    alert("제주4·3평화기념관에 문의 후 열람 하시기 바랍니다.");
                }
            }
        }
        // ---------------------------------------------------------------------------------



        /*
            이미지뷰어 닫기 버튼
         */
        // ---------------------------------------------------------------------------------
        function handleCloseToPop() {
            document.querySelector('#pop-image-viewer').style.display = "none";
        }
        // ---------------------------------------------------------------------------------


        /*
            뒤로가기 버튼 이벤트
         */
        // ---------------------------------------------------------------------------------
        function handleMoveToPage() {
        	//urlSearch = new URLSearchParams(location.search);
        	//const url = urlSearch.get('type')
        	var url = $('.on')
        	console.log(url);
        	if(url.hasClass('doc')){
        		location.href="/data/document/list.do";
        	}else if(url.hasClass('new')){
        		location.href="/data/news/list.do";
        	}else if(url.hasClass('pho')){
        		location.href="/data/photo/list.do";
        	}else if(url.hasClass('aud')){
        		location.href="/data/audio/list.do";
        	}else if(url.hasClass('bok')){
        		location.href="/data/publication/list.do";
        	}
           
        }
        // ---------------------------------------------------------------------------------
    </script>


	

